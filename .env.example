# ==============================================================================
# NEXURA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB INTEGRATION & TELEMETRY
# Required for: Commit streams, PRs/Issues cockpit, CI/CD Actions, and Security audit.
# Scopes recommended for Personal Access Token (PAT):
# - repo (Full control of private repositories)
# - workflow (Access to GitHub Actions workflows)
# - read:packages (Access to Container & Package Registry)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USERNAME=bagja-iskandar

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (PERSISTENT CLOUD DATA LAYER)
# Required for: Production persistent database (projects, sprints, tasks).
# Find these in Supabase Dashboard -> Project Settings -> API.
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY: service_role secret key (recommended for server endpoints)
# Fallback: if not set, Nexura automatically operates on local Nitro KV store.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_KEY=anon_or_publishable_key_fallback

# ------------------------------------------------------------------------------
# 3. VERCEL DEPLOYMENT TELEMETRY (OPTIONAL)
# Required for: Live deployment status and deployment environment badges.
# Find in: Vercel Dashboard -> Account Settings -> Tokens
# ------------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ------------------------------------------------------------------------------
# 4. SYSTEM ENVIRONMENT
# Set to 'production' on deployment platform.
# ------------------------------------------------------------------------------
NODE_ENV=production
