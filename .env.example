# ==============================================================================
# NEXURA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB INTEGRATION & TELEMETRY
# Required for: Commit streams, PRs/Issues cockpit, CI/CD Actions, and Security audit.
# Scopes recommended for Personal Access Token (PAT):
# - repo (Full control of private repositories)
# - workflow (Access to GitHub Actions workflows)
# - read:packages (Access to Container & Package Registry)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USERNAME=bagja-iskandar

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (PERSISTENT CLOUD DATA LAYER)
# Required for: Production persistent database (projects, sprints, tasks, project_notes).
# Find these in Supabase Dashboard -> Project Settings -> API.
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY: service_role secret key (recommended for server endpoints)
# Fallback: if not set, Nexura automatically operates on local Nitro KV store.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_KEY=anon_or_publishable_key_fallback

# ------------------------------------------------------------------------------
# 3. WORKSPACE SECURITY & ACCESS CONTROL (FAIL-CLOSED AUTHENTICATION)
# Required for:
# - Admin session authentication & handshake (POST /api/auth/session)
# - Data mutation protection (POST, PUT, PATCH, DELETE across /api/**)
# - GitHub telemetry endpoints protection (/api/github/**)
# - Cryptographic HMAC-SHA256 session token signing (v1.<nonce>.<iat>.<exp>.<sig>)
# In production (NODE_ENV=production), NEXURA_ACCESS_KEY or SUPABASE_SERVICE_ROLE_KEY
# is mandatory; if missing, server fails closed with HTTP 500 SERVER_SECURITY_UNCONFIGURED.
# In local development, leave blank or set NEXURA_DEV_AUTH_BYPASS=true to bypass.
# ------------------------------------------------------------------------------
NEXURA_ACCESS_KEY=your_secure_workspace_access_key_here
# NEXURA_DEV_AUTH_BYPASS=false

# ------------------------------------------------------------------------------
# 4. VERCEL DEPLOYMENT TELEMETRY (OPTIONAL)
# Required for: Live deployment status and deployment environment badges.
# Find in: Vercel Dashboard -> Account Settings -> Tokens
# ------------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ------------------------------------------------------------------------------
# 5. SYSTEM ENVIRONMENT
# Set to 'production' on deployment platform.
# ------------------------------------------------------------------------------
NODE_ENV=production
